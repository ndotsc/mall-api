// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  price     Int
  cover     String?
  desc      String?
  categoryId Int?
  category Category? @relation(fields: [categoryId], references: [id])
  favorites Favorite[] // 反向关系：商品可被多人收藏
  deletedAt DateTime? // 软删除标记：非 null 表示已删除（查询自动过滤）
  createdAt DateTime @default(now())

  @@index([deletedAt])
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  cover     String?
  summary   String?
  content   String   @db.Text
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id  Int  @id @default(autoincrement())
  userId   Int?
  orderNo  String @unique
  totalAmount Int // 单位： 分（优惠后的实付金额）
  payType  String @default("wechat")
  status  Int @default(1) // 1=待发货 2=已发货 3=已完成
  receiverName String
  receiverPhone String
  address String
  remark String?
  discountAmount Int @default(0) // 优惠金额（分），默认 0
  userCouponId   Int?            // 使用的用户券 id（未用券为 null）
  createdAt DateTime @default(now())
  items  OrderItem[]
}

model OrderItem {
  id Int @id @default(autoincrement())
  orderId Int
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  name String
  price Int  // 下单时快照单价
  cover String?
  number Int
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  sort     Int       @default(0)
  products Product[]
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String                          // 存 bcrypt 哈希，绝不存明文
  role      Int      @default(1)            // 1=普通用户 2=管理员
  nickname  String?
  avatar    String?
  openid    String?  @unique                // 微信 openid（小程序/App 微信登录）；密码用户为 null
  unionid   String?                         // 微信 unionid（同主体多应用统一标识，可选）
  deletedAt DateTime?                       // 软删除标记：非 null 表示已删除（查询自动过滤）
  createdAt DateTime  @default(now())

  @@index([deletedAt])
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  number    Int      @default(1)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  phone     String
  province  String?
  city      String?
  district  String?
  detail    String
  isDefault Boolean  @default(false)
  createdAt DateTime  @default(now())

  @@index([userId])
}

// 刷新令牌：access token 短期（默认 15m），refresh token 长期（默认 7d）入库，
// 支持「轮换」（旧 refresh 用一次即作废）与「整族吊销」（logout 让本次登录链全部失效）。
// id 即 refresh token 的 jti，全局唯一；familyId 把一次登录及其后续刷新串成同一家族。
model RefreshToken {
  id         String   @id                   // 即 refresh token 的 jti
  userId     Int
  familyId   String                         // 登录家族：logout 时整族吊销
  expiresAt  DateTime                       // 与 JWT exp 对齐
  revoked    Boolean  @default(false)        // 是否已吊销（注销 / 轮换后旧令牌置 true）
  replacedBy String?                        // 轮换后指向新 jti，用于检测 refresh token 复用
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

// 商品评价：用户购买/浏览后对商品的评分与文字评价。
// 用户名采用「创建时快照 reviewerName」，避免查询时 join User（User 含敏感字段，且本项目用标量关联）。
// 不纳入软删除集合（prisma.js 的 SOFT_DELETE_MODELS 仅 User/Product），评价可独立物理管理。
model Review {
  id           Int      @id @default(autoincrement())
  userId       Int
  reviewerName String                         // 评价人用户名快照（展示用，前端可脱敏）
  productId    Int
  rating       Int                            // 评分 1-5
  content      String?                        // 文字评价，可选
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([userId])
}

// 收藏/心愿单：用户对商品的收藏关系。
// 复合唯一约束 [userId, productId] 防止同一用户重复收藏同一商品；
// 不纳入软删除集合（prisma.js 的 SOFT_DELETE_MODELS 仅 User/Product），收藏记录独立物理管理。
model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade) // 关联商品，支持 include 快照
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// 优惠券模板（批次）：定义一种券的规则与发放量。
// type: full_reduction 满减 | discount 折扣 | instant 立减
//   - 满减：subtotal >= threshold 才可减 value（分）
//   - 折扣：value=折扣率*100（如 90 表示 9 折），maxDiscount 可选封顶（分）
//   - 立减：无门槛直接减 value（分）
// total: 发行总量，-1 表示不限量；perUserLimit: 每人限领张数。
model Coupon {
  id           Int      @id @default(autoincrement())
  name         String
  type         String   // 'full_reduction' | 'discount' | 'instant'
  threshold    Int      @default(0)  // 使用门槛（分）；满减必填，立减/折扣可 0=无门槛
  value        Int      // 满减/立减：减免额(分)；折扣：折扣率*100（90=9折）
  maxDiscount  Int?     // 折扣封顶(分)，仅折扣类型
  validFrom    DateTime
  validTo      DateTime
  total        Int      @default(-1) // 发行总量；-1 表示不限量
  perUserLimit Int      @default(1)  // 每人限领
  createdAt    DateTime @default(now())

  userCoupons  UserCoupon[] // 反向关系：一种券可被多人领取

  @@index([validFrom])
  @@index([validTo])
}

// 用户优惠券（领取后归属用户）。
// status: unused 未使用 | used 已使用；已过期不在 DB 存（领取时 validTo 内，展示时按模板 validTo 计算「已过期」）。
// orderId: 使用后记录的订单 id，便于回溯。
model UserCoupon {
  id        Int      @id @default(autoincrement())
  userId    Int
  couponId  Int
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade) // 关联券模板，支持 include
  status    String   @default("unused") // 'unused' | 'used'
  orderId   Int?
  claimedAt DateTime @default(now())
  usedAt    DateTime?

  @@index([userId, status])
  @@index([couponId])
}
