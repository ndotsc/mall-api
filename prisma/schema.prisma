// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  price     Int
  cover     String?
  desc      String?
  categoryId Int?
  category Category? @relation(fields: [categoryId], references: [id])
  createdAt DateTime @default(now())
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  cover     String?
  summary   String?
  content   String   @db.Text
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id  Int  @id @default(autoincrement())
  userId   Int?
  orderNo  String @unique
  totalAmount Int // 单位： 分
  payType  String @default("wechat")
  status  Int @default(1) // 1=待发货 2=已发货 3=已完成
  receiverName String
  receiverPhone String
  address String
  remark String?
  createdAt DateTime @default(now())
  items  OrderItem[]
}

model OrderItem {
  id Int @id @default(autoincrement())
  orderId Int
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  name String
  price Int  // 下单时快照单价
  cover String?
  number Int
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  sort     Int       @default(0)
  products Product[]
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String                          // 存 bcrypt 哈希，绝不存明文
  role      Int      @default(1)            // 1=普通用户 2=管理员
  nickname  String?
  avatar    String?
  createdAt DateTime  @default(now())
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  number    Int      @default(1)
  createdAt DateTime  @default(now())
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  phone     String
  detail    String
  isDefault Boolean  @default(false)
  createdAt DateTime  @default(now())
}
