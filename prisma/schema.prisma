// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  price     Int
  cover     String?
  desc      String?
  categoryId Int?
  category Category? @relation(fields: [categoryId], references: [id])
  deletedAt DateTime? // 软删除标记：非 null 表示已删除（查询自动过滤）
  createdAt DateTime @default(now())

  @@index([deletedAt])
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  cover     String?
  summary   String?
  content   String   @db.Text
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id  Int  @id @default(autoincrement())
  userId   Int?
  orderNo  String @unique
  totalAmount Int // 单位： 分
  payType  String @default("wechat")
  status  Int @default(1) // 1=待发货 2=已发货 3=已完成
  receiverName String
  receiverPhone String
  address String
  remark String?
  createdAt DateTime @default(now())
  items  OrderItem[]
}

model OrderItem {
  id Int @id @default(autoincrement())
  orderId Int
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  name String
  price Int  // 下单时快照单价
  cover String?
  number Int
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  sort     Int       @default(0)
  products Product[]
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String                          // 存 bcrypt 哈希，绝不存明文
  role      Int      @default(1)            // 1=普通用户 2=管理员
  nickname  String?
  avatar    String?
  openid    String?  @unique                // 微信 openid（小程序/App 微信登录）；密码用户为 null
  unionid   String?                         // 微信 unionid（同主体多应用统一标识，可选）
  deletedAt DateTime?                       // 软删除标记：非 null 表示已删除（查询自动过滤）
  createdAt DateTime  @default(now())

  @@index([deletedAt])
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  number    Int      @default(1)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  phone     String
  province  String?
  city      String?
  district  String?
  detail    String
  isDefault Boolean  @default(false)
  createdAt DateTime  @default(now())

  @@index([userId])
}

// 刷新令牌：access token 短期（默认 15m），refresh token 长期（默认 7d）入库，
// 支持「轮换」（旧 refresh 用一次即作废）与「整族吊销」（logout 让本次登录链全部失效）。
// id 即 refresh token 的 jti，全局唯一；familyId 把一次登录及其后续刷新串成同一家族。
model RefreshToken {
  id         String   @id                   // 即 refresh token 的 jti
  userId     Int
  familyId   String                         // 登录家族：logout 时整族吊销
  expiresAt  DateTime                       // 与 JWT exp 对齐
  revoked    Boolean  @default(false)        // 是否已吊销（注销 / 轮换后旧令牌置 true）
  replacedBy String?                        // 轮换后指向新 jti，用于检测 refresh token 复用
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}
