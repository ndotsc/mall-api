# 复制本文件为 .env 后填写（.env 已被 .gitignore 忽略，不会入库）

# 数据库连接（与 docker-compose.yml 里的 mysql 账号一致）
# 生产可调连接池上限（按需，默认约连接数 = 机器核数*2+1）：
#   DATABASE_URL="mysql://mall:mall123@localhost:3306/mall?connection_limit=10"
DATABASE_URL="mysql://mall:mall123@localhost:3306/mall"

# JWT 签名密钥：务必随机且保密，生成方式：
#   openssl rand -base64 32
JWT_SECRET="replace-with-openssl-rand-base64-32"

# 服务端口（可选，默认 3000）
PORT=3000

# 日志：LOG_LEVEL=debug|info|warn|error（默认 info）
#      LOG_FILE=./logs/api.log 可把日志同时落盘为 JSON 行（便于 ELK/Loki 采集）
#      LOG_BODY=true 会在访问日志里记录脱敏后的请求体/查询参数（默认 false，避免泄露密码/token）
LOG_LEVEL="info"
# LOG_FILE=""
# LOG_BODY="false"

# 微信登录（可选；H5 / 小程序 / App 三端共用，留空则 wx-login 不可用）
# - 小程序端：uni.login 拿 code -> 后端 code2Session 换 openid（免费，无需认证）
# - H5 微信内网页授权（一键登录）：需已认证公众号(AppID/AppSecret) + 已备案域名
# - App 微信登录：需微信开放平台移动应用(开发者资质认证) + 同一 AppID
WX_APPID=""
WX_SECRET=""

# 公众号网页授权（H5 微信一键登录）专用凭证；留空则回退使用上面的 WX_APPID / WX_SECRET
# 仅当你为公众号和小程序配置了不同的 AppID 时才需要单独填
WX_OA_APPID=""
WX_OA_SECRET=""

# 多实例部署：用 Redis 共享「限流计数」和「注销黑名单」，保证多台实例行为一致
# 留空则退化为进程内存储（单实例没问题；多实例时各实例各计各的、黑名单互不可见）
# 启用需先 `pnpm add ioredis`
# REDIS_URL="redis://localhost:6379"

# 可选 APM（Sentry）错误聚合 / 性能监控。留空则不启用（也不会去加载 @sentry/node）
# 启用需先 `pnpm add @sentry/node`
# SENTRY_DSN="https://xxxx@sentry.io/123"
# APP_RELEASE="mall-api@1.0.0"   # 可选，标记上报来源版本

# 对外公开基址（可选）：用于 OpenAPI 文档的 servers 字段，方便前端 / 网关直接照抄
# PUBLIC_BASE_URL="https://api.example.com/api"
